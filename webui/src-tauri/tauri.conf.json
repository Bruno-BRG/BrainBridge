{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BrainBridge",
  "version": "2.0.0",
  "identifier": "com.brainbridge.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "BrainBridge",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Medical",
    "externalBin": ["binaries/brainbridge-server"],
    "linux": {
      "deb": {},
      "appimage": { "bundleMediaFramework": true }
    }
  }
}
