%% BrainBridge v2 — pipeline de dados e IA (ao vivo, janela unica)
%% Do sinal bruto a atuacao, com calibracao (fine-tuning) e RL online.
flowchart TD
    subgraph AQ[Aquisicao — 16 canais @ 125 Hz]
        A1[Touca OpenBCI Daisy<br/>16ch EXG, 125 Hz]
        A2[Backend FastAPI + WebSocket<br/>streaming compacto]
        A1 --> A2
    end
    subgraph REC[Gravacao — sempre RAW]
        R1[Logger RAW<br/>+ timestamps de recepcao]
        R2[CSV OpenBCI<br/>Sample Index, EXG0..15, Annotations T0/T1/T2]
        A2 --> R1 --> R2
    end
    subgraph WIN[Janelamento ao vivo]
        W1[Janela 250 amostras = 2 s<br/>stride 125 no modo Livre ~1 pred/s]
        W2[Janela unica, instantanea<br/>1 job pendente, descarta antigas]
        A2 --> W1 --> W2
    end
    subgraph PRE[Pre-processamento identico treino/inferencia/RL]
        direction TB
        P1[Remapeia canais -> 16<br/>reamostra qualquer fs -> 125 Hz]
        P2[Filtro Butterworth SOS ordem 6<br/>bandpass 8-30 Hz, sosfiltfilt<br/>na janela fechada]
        P3{Modelo com EA?}
        P4[Euclidean Alignment<br/>bandpass -> EA -> z-score]
        P5[Z-score por canal<br/>saida float32 250x16]
        P1 --> P2 --> P3
        P3 -->|sim| P4 --> P5
        P3 -->|nao| P5
    end
    W2 --> P1
    R2 -->|treino offline| P1
    subgraph BASE[Modelo base generalista]
        B1[EEGNet adaptativa GAP<br/>treino Leave-Subjects-Out<br/>multi-dataset, val ~0.64]
        B2[Zero-shot no paciente novo<br/>~0.55-0.58]
        B1 --> B2
    end
    subgraph CAL[Calibracao — 10 trials T1/T2, 1x por paciente]
        C1[Fine-tune rede toda<br/>10 epocas, LR 5e-5]
        C2[Aumento leve no treino<br/>2 replicas: ruido + shift temporal<br/>sem channel-dropout]
        C3[Peso de classe balanceado<br/>validacao intacta]
        C4[Modelo do paciente<br/>patient_id.keras + pointer<br/>S012: 0.58 -> 0.71]
        C1 --> C2 --> C3 --> C4
    end
    P5 -->|janelas rotuladas| C1
    B2 -->|parte do checkpoint| C1
    subgraph INF[Inferencia ao vivo — instantanea]
        I1[Softmax T1 x T2<br/>+ confianca]
        I2{confianca >= 0.6<br/>e cooldown 3 s?}
        I3[Aciona VR e/ou ortese ESP32<br/>l=flexao e=extensao o=parar]
        I4[Modo Jogo: trial com resposta esperada<br/>Modo Livre: loop continuo, sinks opcionais]
        I1 --> I2 -->|sim| I3
        I2 -->|nao| I4
        I3 --> I4
    end
    C4 -->|carrega| I1
    P5 -->|janela pronta| I1
    subgraph RL[RL online — feedback humano, sem mudar a UX]
        F1{Botoes v/x ou<br/>CORRECT/WRONG do VR?}
        F2[Rotula a ultima janela<br/>erro pesa 3x]
        F3[A cada K=5 feedbacks<br/>worker em background]
        F4[Clone-fit-swap: clona,<br/>3 epocas LR 5e-5 + replica<br/>com ruido, troca sob lock]
        F5[Guards: max 20 updates/sessao<br/>+ Restaurar base pre-RL]
        F6[S012: 0.71 -> 0.73 pico 0.79<br/>S011: 0.54 -> 0.75]
        F1 -->|rotulo| F2 --> F3 --> F4 --> F5 --> F6
        F4 -.->|atualiza pesos| I1
    end
    I1 --> F1
    P5 -.->|janela RAW + pre identico| F4
